{
  "name": "shuangyu-assistant",
  "version": "1.3.2",
  "description": "双鱼部落语音厅 - 写作业机器人桌面客户端",
  "author": "shuangyu",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/dev.cjs",
    "dev": "node scripts/dev.cjs --dev",
    "test": "node scripts/test.cjs",
    "check": "node scripts/check.cjs",
    "diagnose": "node scripts/diagnose.mjs",
    "classify": "node scripts/classify-users.cjs",
    "smoke": "node scripts/smoke.cjs",
    "dist": "node scripts/build.cjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "engines": { "node": ">=20" },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.shuangyu.assistant",
    "productName": "双鱼部落写作业机器人",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "design/**/*",
      "scripts/dev.cjs",
      "tools/syl-bridge/syl-bridge.apk",
      "manifest.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/logo.png"
    },
    "asarUnpack": [
      "tools/syl-bridge/syl-bridge.apk"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "双鱼部落写作业机器人"
    }
  }
}
